# Copy to .env and fill in. Never commit .env.

# What to track: an example template id or a path to your own profile JSON.
# Templates: smartphones-india, ev-scooters-india (see `fanvaaz profile list`).
# Leave empty to choose on first sign-in (the admin page shows an onboarding step).
FANVAAZ_PROFILE=

# YouTube Data API v3 key (Google Cloud console -> APIs & Services -> enable "YouTube Data API v3"
# -> Credentials; restrict the key to that API). Fanvaaz runs on live data only.
FANVAAZ_YOUTUBE_API_KEY=

# Database: empty = SQLite file at FANVAAZ_DB_PATH. Postgres (Cloud SQL / docker compose) enables pgvector RAG.
FANVAAZ_DATABASE_URL=

# Optional LLM, any OpenAI-compatible endpoint. Leave empty for rules-only mode.
# Gemini (default): get a key at aistudio.google.com/apikey
FANVAAZ_LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
FANVAAZ_LLM_API_KEY=
FANVAAZ_LLM_MODEL=gemini-flash-latest
FANVAAZ_EMBED_MODEL=gemini-embedding-001
# Judge model for DeepEval / Ragas (make llm-evals); defaults to FANVAAZ_LLM_MODEL
FANVAAZ_JUDGE_MODEL=

# Governance: kill switch and budgets (USD). A refused call keeps the rule-based result.
FANVAAZ_LLM_ENABLED=true
FANVAAZ_MAX_COST_PER_RUN_USD=0.50
FANVAAZ_MAX_COST_PER_DAY_USD=2.00
FANVAAZ_MAX_PROMPT_TOKENS=12000

# First admin account, created at startup if it does not exist. Sign in at /login.
FANVAAZ_ADMIN_EMAIL=you@example.com
FANVAAZ_ADMIN_PASSWORD=choose-a-long-passphrase

# Who may create accounts at /signup (comma-separated domains; empty = anyone with the link)
FANVAAZ_SIGNUP_DOMAINS=

# Set true when served over HTTPS (marks the session cookie Secure)
FANVAAZ_COOKIE_SECURE=false

# Service token for CI, Cloud Scheduler and the admin MCP scope (Authorization: Bearer ...).
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
FANVAAZ_API_TOKEN=
# Read-only token for MCP clients (Claude Desktop / Claude Code over HTTP at /mcp)
FANVAAZ_MCP_TOKEN=

# Optional in-process daily collection at this local time (empty = off; Cloud Run uses Cloud Scheduler)
FANVAAZ_DAILY_RUN_AT=
FANVAAZ_TIMEZONE=Asia/Kolkata

# Collection size (N is explained in the README)
FANVAAZ_TOP_N=50
FANVAAZ_COMMENTS_PER_VIDEO=100
