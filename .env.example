# Copy to .env and fill in. Never commit .env.

# YouTube Data API v3 key (Google Cloud console -> APIs & Services -> enable "YouTube Data API v3" -> Credentials)
ATOMPULSE_YOUTUBE_API_KEY=

# Optional LLM, any OpenAI-compatible endpoint. Leave empty for rules-only mode.
# Groq:   https://api.groq.com/openai/v1        model llama-3.3-70b-versatile
# Gemini: https://generativelanguage.googleapis.com/v1beta/openai   model gemini-2.0-flash
ATOMPULSE_LLM_BASE_URL=
ATOMPULSE_LLM_API_KEY=
ATOMPULSE_LLM_MODEL=llama-3.3-70b-versatile

# Required to trigger POST /api/v1/runs (collection spends YouTube quota)
ATOMPULSE_ADMIN_TOKEN=change-me-to-a-long-random-string

# Collection size (N is explained in the README)
ATOMPULSE_TOP_N=50
ATOMPULSE_COMMENTS_PER_VIDEO=100

# Docker: what to collect on first boot when the volume is empty (demo | youtube)
ATOMPULSE_BOOT_SOURCE=demo
