# Copy to .env and fill in. Never commit .env.

# What to track: a ready-made profile id or a path to your own profile JSON.
# Presets: atomberg-fans, ather-scooters (see `fanvaaz profile list`). An admin can
# change it later in the admin panel; that choice wins over this default.
FANVAAZ_PROFILE=atomberg-fans

# YouTube Data API v3 key (Google Cloud console -> APIs & Services -> enable "YouTube Data API v3" -> Credentials)
FANVAAZ_YOUTUBE_API_KEY=

# Optional LLM, any OpenAI-compatible endpoint. Leave empty for rules-only mode.
# Groq:   https://api.groq.com/openai/v1        model llama-3.3-70b-versatile
# Gemini: https://generativelanguage.googleapis.com/v1beta/openai   model gemini-2.0-flash
FANVAAZ_LLM_BASE_URL=
FANVAAZ_LLM_API_KEY=
FANVAAZ_LLM_MODEL=llama-3.3-70b-versatile

# First admin account, created at startup if it does not exist. Sign in at /login.
FANVAAZ_ADMIN_EMAIL=you@example.com
FANVAAZ_ADMIN_PASSWORD=choose-a-long-passphrase

# Who may create accounts at /signup (comma-separated domains; empty = anyone with the link)
FANVAAZ_SIGNUP_DOMAINS=

# Set true when served over HTTPS (marks the session cookie Secure)
FANVAAZ_COOKIE_SECURE=false

# Service token for CI and tools (Authorization: Bearer ...). Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
FANVAAZ_API_TOKEN=

# Daily collection at this local time (empty = off), in FANVAAZ_TIMEZONE
FANVAAZ_DAILY_RUN_AT=06:30
FANVAAZ_TIMEZONE=Asia/Kolkata

# Collection size (N is explained in the README)
FANVAAZ_TOP_N=50
FANVAAZ_COMMENTS_PER_VIDEO=100

# Docker: what to collect on first boot when the volume is empty (demo | youtube)
FANVAAZ_BOOT_SOURCE=demo
